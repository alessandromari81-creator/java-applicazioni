<?xml version="1.0" encoding="UTF-8"?>
<!--
  FILE: pom.xml
  A COSA SERVE: descrive il progetto Maven: nome, versione di Java e LIBRERIE usate.
  PARAGONE LARAVEL: è il composer.json. Maven scarica le librerie (in ~/.m2, come vendor/)
  e compila/avvia il progetto, come Composer + Artisan. ./mvnw è il Maven "wrapper"
  incluso nel progetto, quindi non serve installare Maven.
  I tag <dependency> sono come le voci di "require" in composer.json.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!-- Il "parent" fissa le versioni compatibili di tutte le librerie Spring: non serve indicarle una per una. -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>it.palestra</groupId>
	<artifactId>palestra</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>palestra</name>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<!-- Versione di Java usata per compilare. -->
	<properties>
		<java.version>21</java.version>
		<!-- Versione di springdoc (Swagger/OpenAPI): non è gestita da Spring Boot, quindi la fissiamo noi. -->
		<springdoc.version>3.2.0</springdoc.version>
	</properties>
	<!-- Librerie usate dal progetto. I "starter" sono pacchetti che ne raggruppano diverse. -->
	<dependencies>
		<!-- JPA/Hibernate + Spring Data: entità e repository. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!-- Cache: @Cacheable/@CacheEvict (Spring Cache) con Caffeine come motore IN MEMORIA (non Redis:
		     l'app gira in una sola istanza). Oggi serve solo all'elenco dei ruoli. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-cache</artifactId>
		</dependency>
		<dependency>
			<groupId>com.github.ben-manes.caffeine</groupId>
			<artifactId>caffeine</artifactId>
		</dependency>
		<!-- Invio di email (JavaMailSender): link di conferma registrazione e di reimpostazione della password. In sviluppo le email vanno a
		     Mailpit (finto server di posta, vedi compose.yaml); in produzione serve un server SMTP vero (spring.mail.*). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<!-- Swagger/OpenAPI (springdoc): legge i controller /api e genera da solo la descrizione JSON (/v3/api-docs) e la pagina
		     interattiva (/swagger-ui.html) dove si provano gli endpoint. -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>
		<!-- Spring Security: login, sessioni, CSRF, protezione delle rotte. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!-- Thymeleaf: motore di template HTML lato server -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>
		<!-- Bean Validation: annotazioni @NotBlank, @Email... -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!-- Spring MVC + Tomcat: controller e server web (le rotte/controller). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- Driver JDBC di PostgreSQL: permette a Java di parlare col database -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- Flyway: esegue le migration SQL di src/main/resources/db/migration all'avvio -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<!-- Modulo di Flyway specifico per PostgreSQL (dalla v10 il supporto ai singoli database è separato). -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- OAuth2 Resource Server: permette a Spring Security di leggere e verificare i token JWT ("Authorization: Bearer ...")
		     inviati alla API, e porta con sé la libreria Nimbus per FIRMARE i token al login. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
		</dependency>
		<!-- Layout Dialect: permette i layout con "buchi" da riempire (layout:decorate, layout:fragment) -->
		<dependency>
			<groupId>nz.net.ultraq.thymeleaf</groupId>
			<artifactId>thymeleaf-layout-dialect</artifactId>
		</dependency>
		<!-- Integrazione Thymeleaf-Security (es. mostrare elementi in base al ruolo). -->
		<dependency>
			<groupId>org.thymeleaf.extras</groupId>
			<artifactId>thymeleaf-extras-springsecurity6</artifactId>
		</dependency>

		<!-- Riavvio automatico dell'app quando cambi il codice (solo sviluppo). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<!-- Database H2 in memoria: usato SOLO dai test (profilo "test"), così non serve Docker per provarli. -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Strumenti di test per la parte JPA. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Strumenti di test per la sicurezza (utenti finti nei test). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Strumenti di test per i template. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Strumenti di test per la validazione. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Strumenti di test per i controller (MockMvc). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Testcontainers: avvia un PostgreSQL vero in un contenitore Docker, solo per i test di concorrenza (UltimoAdminConcorrenzaTest).
		     Le versioni le decide Spring Boot. spring-boot-testcontainers fornisce @ServiceConnection (collega da solo il database al
		     contenitore); gli altri due sono la libreria e il suo supporto a JUnit. Servono solo se Docker è acceso: senza, quei test si saltano. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!-- Il plugin Spring Boot permette `./mvnw spring-boot:run` e crea il .jar eseguibile. -->
	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
