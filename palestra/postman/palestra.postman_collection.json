                }
              ]
            }
          }
        },
        {
          "name": "Crea corso",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/corsi",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "corsi"
              ]
            },
            "description": "201 Created. Salva l'id in {{corsoId}}. istruttoreId: id di un utente con ruolo ISTRUTTORE, oppure null.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Zumba {{$timestamp}}\",\n  \"descrizione\": \"Danza\",\n  \"durataMinuti\": 55,\n  \"livello\": \"INTERMEDIO\",\n  \"istruttoreId\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Salva l'id della risorsa creata nella variabile di collection 'corsoId' (le altre richieste la usano).",
                  "if (pm.response.code === 201) { pm.collectionVariables.set('corsoId', pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Modifica corso (PUT: sostituisce tutto)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/corsi/{{corsoId}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "corsi",
                "{{corsoId}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Zumba Fit\",\n  \"descrizione\": \"Danza e fitness\",\n  \"durataMinuti\": 60,\n  \"livello\": \"AVANZATO\",\n  \"istruttoreId\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Elimina corso",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base}}/api/corsi/{{corsoId}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "corsi",
                "{{corsoId}}"
              ]
            },
            "description": "204 se riesce; 409 se ci sono utenti iscritti.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
