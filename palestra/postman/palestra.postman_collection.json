{
  "info": {
    "name": "Palestra API",
    "description": "API REST della Palestra (JWT). 1) Compila la variabile 'password' (scheda Variables della collection) con la password dell'admin; 2) esegui 'Auth > Login' (salva il token da solo); 3) usa le altre richieste. Guida completa: palestra/API.md Ogni richiesta (tranne il Login) ha l'autenticazione Bearer {{token}} impostata direttamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.collectionVariables.set('oggi', new Date().toISOString().slice(0, 10));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:8080"
    },
    {
      "key": "email",
      "value": "admin@palestra.local"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "corsoId",
      "value": "1"
    },
    {
      "key": "utenteId",
      "value": "1"
    },
    {
      "key": "abbonamentoId",
      "value": "1"
    },
    {
      "key": "oggi",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Restituisce il token JWT e lo salva nella variabile {{token}}: da qui in poi le altre richieste sono autenticate.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Se il login riesce, salva il token nella variabile di collection 'token'.",
                  "if (pm.response.code === 200) { pm.collectionVariables.set('token', pm.response.json().token); }"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Corsi",
      "item": [
